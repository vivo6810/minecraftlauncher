{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwilightLauncher",
  "version": "1.0.1",
  "identifier": "io.vivo6810.twilightlauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TwilightLauncher",
        "decorations": false,
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm"],
    "category": "Game",
    "shortDescription": "Lightweight Minecraft: Java Edition launcher",
    "longDescription": "TwilightLauncher is a lightweight cross-platform Minecraft: Java Edition launcher built with Rust, Tauri v2, and React.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
